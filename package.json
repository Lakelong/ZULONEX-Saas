{
  "name": "zulonex-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:business": "node scripts/verify-business-contract.mjs",
    "check:production": "node scripts/check-production-readiness.mjs",
    "build:production": "npm run check:business && npm run check:production && vite build --mode production",
    "test": "npm run check:business && npm run build"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.0.5"
  }
}
